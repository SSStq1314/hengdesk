# 演示 / 验收用镜像：mockupstream、mockmcp、mockoidc，以及端到端脚本 m1accept。
# 不进入默认生产离线包；由 pack-offline.sh --with-acceptance 或本文件单独构建。
FROM golang:1.26.10-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/mockupstream ./cmd/mockupstream \
 && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/mockmcp ./cmd/mockmcp \
 && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/mockoidc ./cmd/mockoidc \
 && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/mockredir ./cmd/mockredir \
 && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/m1accept ./cmd/m1accept

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/mockupstream /out/mockmcp /out/mockoidc /out/mockredir /out/m1accept /usr/local/bin/
WORKDIR /work
# 不要设 ENTRYPOINT：compose 的 command（如 mockmcp -addr :18090）会变成
# entrypoint 的参数，变成「m1accept mockmcp ...」并立刻退出。默认只跑验收脚本。
CMD ["m1accept"]
