# 衡台 HengDesk 部署配置示例。推荐运行 ./install.sh 自动生成 .env；手工使用时复制为 .env 并替换所有 change-me。
# 选择对象存储：默认 SeaweedFS；MinIO 改为 docker-compose.yml:docker-compose.minio.yml；外部 S3 改为 docker-compose.yml:docker-compose.external-s3.yml
COMPOSE_FILE=docker-compose.yml
HENGDESK_VERSION=dev
HENGDESK_HTTP_PORT=8080
HENGDESK_ENV=prod
HENGDESK_COOKIE_SECURE=false

POSTGRES_USER=hengdesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hengdesk

# 至少 32 字节随机串：openssl rand -hex 32
HENGDESK_JWT_SECRET=change-me
HENGDESK_ADMIN_EMAIL=admin@hengdesk.local
HENGDESK_ADMIN_PASSWORD=change-me

# 对象存储（仅 S3 API）
HENGDESK_S3_ENDPOINT=http://seaweedfs:8333
HENGDESK_S3_REGION=us-east-1
HENGDESK_S3_BUCKET=hengdesk
HENGDESK_S3_ACCESS_KEY=change-me
HENGDESK_S3_SECRET_KEY=change-me
HENGDESK_S3_PATH_STYLE=true
